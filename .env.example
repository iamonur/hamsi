# Copy this file to .env and fill in real values. .env is gitignored.

# Auth for the `claude` CLI the Worker/Controller subprocesses invoke.
# If the host machine already has `claude` logged in, this can be left blank.
ANTHROPIC_API_KEY=

# Jira integration (Parameters & Environment > Environment Variables tab can
# also manage these once the app is running).
JIRA_BASE_URL=
JIRA_PAT=
